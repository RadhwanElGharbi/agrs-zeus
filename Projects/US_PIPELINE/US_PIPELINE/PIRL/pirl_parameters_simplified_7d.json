{
  "version": "2.0",
  "description": "Simplified PIRL parameter values for 7D state space (slope optimization only)",
  "last_updated": "2025-11-21",
  "state_space_dim": 7,
  "action_space_dim": 2,
  "optimization_focus": "slope_minimization",
  
  "ppo_rewards": {
    "_comment": "Reward function parameters for 7D state space",
    
    "progress_multiplier": 2.0,
    "_progress_comment": "Reward per meter toward goal. Range: [0.5, 10.0]",
    
    "slope_reward_scale": 10.0,
    "_slope_reward_comment": "Maximum reward for 0% slope (linear 0-20%). Range: [5.0, 50.0]",
    
    "slope_penalty_scale": -100.0,
    "_slope_penalty_comment": "Maximum penalty for 50% slope (quadratic 20-50%). Range: [-500.0, -50.0]",
    
    "boundary_penalty_scale": -50.0,
    "_boundary_comment": "Maximum penalty at AOI boundary. Range: [-200.0, -10.0]",
    
    "boundary_penalty_distance": 100.0,
    "_boundary_distance_comment": "Distance threshold for boundary penalty (meters). Range: [50.0, 200.0]",
    
    "curvature_penalty_rate": -0.5,
    "_curvature_comment": "Penalty per radian of heading change. Range: [-2.0, -0.1]",
    
    "goal_bonus": 1000.0,
    "_goal_comment": "Reward for reaching goal (within 50m). Range: [100.0, 5000.0]"
  },
  
  "constraints": {
    "_comment": "Physical and operational constraints",
    
    "max_slope_percent": 50.0,
    "_max_slope_comment": "Terminal threshold - episode ends with penalty",
    
    "slope_neutral_threshold_percent": 20.0,
    "_slope_neutral_comment": "Slope with 0 reward (linear reward below, quadratic penalty above)",
    
    "max_steps_per_episode": 5000,
    "_max_steps_comment": "Safety limit for episode length",
    
    "step_size_min_m": 40.0,
    "_step_min_comment": "Minimum step size (optimized for 10m DEM resolution)",
    
    "step_size_max_m": 300.0,
    "_step_max_comment": "Maximum step size (balances speed with terrain detail)",
    
    "goal_distance_threshold_m": 50.0,
    "_goal_threshold_comment": "Distance to goal for success and bonus"
  },
  
  "removed_features": {
    "_comment": "Features removed from 29D state space (not used in 7D version)",
    "infrastructure": [
      "road_proximity",
      "railway_proximity",
      "waterway_proximity",
      "powerline_proximity",
      "pipeline_proximity"
    ],
    "land_cover": [
      "land_cover_class",
      "land_cover_cost"
    ],
    "hydraulics": [
      "pressure_drop",
      "flow_velocity",
      "reynolds_number",
      "cumulative_pressure_drop",
      "segments_since_pump"
    ],
    "environmental": [
      "geohazard_risk",
      "soil_capacity",
      "population_density",
      "cadastre_complexity"
    ],
    "crossing_context": [
      "nearest_crossing_dist",
      "nearest_crossing_width",
      "nearest_crossing_type",
      "crossing_before_dist",
      "crossing_after_dist",
      "crossing_cardinal_alignment"
    ],
    "advanced_terrain": [
      "aspect",
      "curvature"
    ],
    "action_components": [
      "crossing_decision"
    ]
  },
  
  "hyperparameters": {
    "_comment": "PPO training hyperparameters",
    "learning_rate": 0.0003,
    "_learning_rate_comment": "Adam optimizer learning rate",
    "batch_size": 256,
    "_batch_size_comment": "Number of samples per gradient update",
    "n_steps": 2048,
    "_n_steps_comment": "Rollout steps before policy update",
    "n_epochs": 10,
    "_n_epochs_comment": "Number of passes over rollout buffer",
    "gamma": 0.99,
    "_gamma_comment": "Discount factor for future rewards",
    "gae_lambda": 0.95,
    "_gae_lambda_comment": "Generalized Advantage Estimation smoothing",
    "clip_range": 0.2,
    "_clip_range_comment": "PPO clipping parameter",
    "ent_coef": 0.01,
    "_ent_coef_comment": "Entropy coefficient for exploration",
    "vf_coef": 0.5,
    "_vf_coef_comment": "Value function loss coefficient",
    "max_grad_norm": 0.5,
    "_max_grad_norm_comment": "Gradient clipping threshold"
  },
  
  "tuning_recommendations": {
    "_comment": "Recommended parameter tuning approach",
    
    "grid_search": {
      "progress_multiplier": [0.5, 1.0, 2.0, 5.0],
      "slope_reward_scale": [5.0, 10.0, 20.0],
      "slope_penalty_scale": [-50.0, -100.0, -200.0]
    },
    
    "total_configurations": 36,
    "_total_comment": "4 × 3 × 3 = 36 parameter combinations",
    
    "evaluation_episodes": 10,
    "_eval_comment": "Episodes per configuration for statistical significance",
    
    "success_criteria": {
      "goal_reach_rate": "> 80%",
      "average_slope": "< 15%",
      "average_reward": "> 0 (positive total rewards)"
    }
  },
  
  "usage": {
    "_comment": "How to use this parameter configuration",
    
    "single_test": "python tune_parameters_us.py --config CONFIG --mode single --progress-multiplier 2.0 --slope-reward-scale 10.0",
    "grid_search": "python tune_parameters_us.py --config CONFIG --mode grid --episodes 10",
    "output": "Results saved as JSON with metrics per configuration"
  }
}

