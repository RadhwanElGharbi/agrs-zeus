    "name": "WGS 84 / UTM zone 33N",
    "units": "meters",
    "justification": "UTM Zone 33N selected for Central Italy location. Projected CRS required for accurate distance, area, and terrain analysis calculations."
  },
  "measurement_system": "SI",
  "units": {
    "length": "meters",
    "area": "square_meters",
    "elevation": "meters",
    "slope": "percentage",
    "temperature": "celsius",
    "cost": "USD",
    "note": "All measurements use SI units unless explicitly stated otherwise. Consistency is critical across all datasets."
  },
  "aoi": {
    "file": "aoi/study_area.geojson",
    "bbox_wgs84": {
      "minx": 13.454779,
      "miny": 42.857057,
      "maxx": 13.938769,
      "maxy": 43.438886
    },
    "area_km2": null,
    "description": "Study area provided by SAIPEM for pipeline routing analysis, Central Italy (Lazio/Abruzzo region)"
