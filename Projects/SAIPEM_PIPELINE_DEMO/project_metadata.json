  "routing_endpoints": {
    "start_point": "aoi/start_point.geojson",
    "end_point": "aoi/end_point.geojson",
    "description": "Pipeline start and end points provided by SAIPEM"
  },
  "inputs": {
    "source_directory": "inputs/DATA_x_AI_ROUTING/",
    "files": [
      "STUDY_AREA.kmz - Area of interest boundary",
      "START_POINT.kmz - Pipeline starting point",
      "END_POINT.kmz - Pipeline ending point",
      "AI_Routing_Criteria.xlsx - Routing criteria and constraints",
      "000-LC-D-80022_0.pdf - Technical specifications",
      "curve a 40DN (a freddo).pdf - Pipeline specifications"
    ]
  },
  "contacts": {
