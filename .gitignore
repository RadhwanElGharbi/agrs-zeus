# Data files (too large for Git)
Projects/*/data/rasters/*.tif
Projects/*/data/rasters/*.tiff
Projects/*/data/vectors/*.gpkg
Projects/*/data/vectors/*.shp
Projects/*/data/vectors/*.geojson

# Keep directory structure but not large files
!Projects/*/data/rasters/.gitkeep
!Projects/*/data/vectors/.gitkeep

# Large dataset inventories (optional)
# data/*_datasets_inventory.csv

