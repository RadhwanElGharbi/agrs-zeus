# Production Environment Configuration
# Copy this to .env and update values

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Authentication (CHANGE THESE IN PRODUCTION!)
YC_DEMO_PASSWORD=change-this-password-for-yc-demo
ADMIN_PASSWORD=change-this-password-for-admin

# API Keys (copy from your current .env)
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# Digital Twin (Pixel Streaming) - Update to production URL
PIXEL_STREAMING_URL=ws://your-server:8888
