{
  "name": "agrs-zeus-gui-v2",
  "version": "2.1.0",
  "description": "AGRS ZEUS Enterprise Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:electron\"",
    "dev:next": "next dev -H 0.0.0.0 -p 3001",
    "dev:electron": "wait-on http://localhost:3001 && electron . --no-sandbox",
    "build": "next build",
    "build:electron": "electron-builder",
    "electron-pack": "electron-builder --linux --x64",
    "start": "next start -p 3001",
    "lint": "next lint"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@types/leaflet": "^1.9.21",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.316.0",
    "maplibre-gl": "^4.7.1",
    "mgrs": "^2.1.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-joyride": "^2.9.3",
    "react-map-gl": "^7.1.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.2.1",
    "three": "^0.181.2",
    "utm": "^1.1.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.182.0",
    "@types/utm": "^1.1.4",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "postcss": "^8.4.33",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.agrs.zeus.gui",
    "productName": "AGRS ZEUS GUI v2",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Science"
    }
  }
}
